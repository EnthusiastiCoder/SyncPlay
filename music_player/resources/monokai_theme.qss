/* SyncPlay Monokai Theme */

QMainWindow {
    background-color: #272822;
    color: #f8f8f2;
}

QWidget {
    background-color: #272822;
    color: #f8f8f2;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #49483e;
    background-color: #1e1f1c;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #3e3d32;
    color: #f8f8f2;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #49483e;
    color: #a6e22e;
}

QTabBar::tab:hover {
    background-color: #44443a;
}

QPushButton {
    background-color: #3e3d32;
    color: #f8f8f2;
    border: 1px solid #49483e;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

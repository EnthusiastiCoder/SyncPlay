/* SyncPlay Monokai Theme */

QMainWindow {
    background-color: #272822;
    color: #f8f8f2;
}

QWidget {
    background-color: #272822;
    color: #f8f8f2;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #49483e;
    background-color: #1e1f1c;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #3e3d32;
    color: #f8f8f2;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #49483e;
    color: #a6e22e;
}

QTabBar::tab:hover {
    background-color: #44443a;
}

QPushButton {
    background-color: #3e3d32;
    color: #f8f8f2;
    border: 1px solid #49483e;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #49483e;
    border-color: #75715e;
}

QPushButton:pressed {
    background-color: #55544a;
}

QPushButton:checked {
    background-color: #a6e22e;
    color: #272822;
    border-color: #a6e22e;
}

QPushButton:disabled {
    background-color: #2e2d28;
    color: #75715e;
    border-color: #3a3a30;
}

QSlider::groove:horizontal {
    background: #3e3d32;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #a6e22e;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #c4f050;
}

QSlider::sub-page:horizontal {
    background: #a6e22e;
    border-radius: 3px;
}

QLabel {
    background-color: transparent;
    color: #f8f8f2;
}

QListWidget {
    background-color: #1e1f1c;
    border: 1px solid #49483e;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

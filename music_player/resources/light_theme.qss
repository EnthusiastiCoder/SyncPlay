/* SyncPlay Light Theme */

QMainWindow {
    background-color: #f5f5f5;
    color: #2d2d2d;
}

QWidget {
    background-color: #f5f5f5;
    color: #2d2d2d;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #e8e8e8;
    color: #2d2d2d;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #4a7ce0;
}

QTabBar::tab:hover {
    background-color: #f0f0f0;
}

QPushButton {
    background-color: #e8e8e8;
    color: #2d2d2d;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #dce4f5;
    border-color: #4a7ce0;
}

QPushButton:pressed {
    background-color: #c8d8f0;
}

QPushButton:checked {
    background-color: #4a7ce0;
    color: #ffffff;
    border-color: #4a7ce0;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #aaaaaa;
    border-color: #e0e0e0;
}

QSlider::groove:horizontal {
    background: #d8d8d8;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #4a7ce0;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #3a6cd0;
}

QSlider::sub-page:horizontal {
    background: #4a7ce0;
    border-radius: 3px;
}

QLabel {
    background-color: transparent;
    color: #2d2d2d;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px;
    border-radius: 4px;
    color: #2d2d2d;
}

QListWidget::item:selected {
    background-color: #dce4f5;
    color: #4a7ce0;
}

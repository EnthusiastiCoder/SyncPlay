/* SyncPlay Light Theme */

QMainWindow {
    background-color: #f5f5f5;
    color: #2d2d2d;
}

QWidget {
    background-color: #f5f5f5;
    color: #2d2d2d;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    border-radius: 8px;
}

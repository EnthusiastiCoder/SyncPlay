/* SyncPlay Solarized Dark Theme */

QMainWindow {
    background-color: #002b36;
    color: #839496;
}

QWidget {
    background-color: #002b36;
    color: #839496;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #073642;
    background-color: #00212b;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #073642;
    color: #839496;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #0d4a5a;
    color: #268bd2;
}

QTabBar::tab:hover {
    background-color: #0a3d4a;
}

QPushButton {
    background-color: #073642;
    color: #839496;
    border: 1px solid #0d4a5a;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #0d4a5a;
    border-color: #268bd2;
}

QPushButton:pressed {
    background-color: #1a5a6a;
}

QPushButton:checked {
    background-color: #268bd2;
    color: #002b36;
    border-color: #268bd2;
}

QPushButton:disabled {
    background-color: #052e38;
    color: #586e75;
    border-color: #073642;
}

QSlider::groove:horizontal {
    background: #073642;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #268bd2;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #3a9fe0;
}

QSlider::sub-page:horizontal {
    background: #268bd2;
    border-radius: 3px;
}

QLabel {
    background-color: transparent;
    color: #839496;
}

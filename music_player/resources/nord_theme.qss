/* SyncPlay Nord Theme */

QMainWindow {
    background-color: #2e3440;
    color: #eceff4;
}

QWidget {
    background-color: #2e3440;
    color: #eceff4;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #4c566a;
    background-color: #242933;
    border-radius: 8px;
}

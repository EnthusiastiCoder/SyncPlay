/* SyncPlay Nord Theme */

QMainWindow {
    background-color: #2e3440;
    color: #eceff4;
}

QWidget {
    background-color: #2e3440;
    color: #eceff4;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #4c566a;
    background-color: #242933;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #3b4252;
    color: #eceff4;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #4c566a;
    color: #88c0d0;
}

QTabBar::tab:hover {
    background-color: #434c5e;
}

QPushButton {
    background-color: #3b4252;
    color: #eceff4;
    border: 1px solid #4c566a;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4c566a;
    border-color: #5e6d82;
}

QPushButton:pressed {
    background-color: #5e6d82;
}

QPushButton:checked {
    background-color: #88c0d0;
    color: #2e3440;
    border-color: #88c0d0;
}

QPushButton:disabled {
    background-color: #323846;
    color: #616e88;
    border-color: #404858;
}

QSlider::groove:horizontal {
    background: #3b4252;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #88c0d0;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
